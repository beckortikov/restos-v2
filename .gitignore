# Dependencies
node_modules/
.pnpm-store/

# Build artifacts
dist/
build/
.next/
*.tsbuildinfo
out/

# Electron release artifacts
desktop/release/
desktop/data/
desktop/dist/
desktop/frontend/

# Сайдкар и клиентские утилиты PG — сборочные артефакты, не исходники.
# .github/workflows/desktop-release.yml создаёт весь desktop/resources/ с нуля:
# собирает restos-server.exe и качает pg_dump/pg_restore + DLL. В git они лежали
# по недосмотру и устаревали — закоммиченный restos-server был на два месяца
# старше кода и не содержал разведения pg-bin/pg-runtime, из-за чего локальный
# запуск стартовал 12 секунд вместо 0,15 (embedded-postgres распаковывал 133 МБ
# на каждом старте). Для локального запуска desktop: cd server && make build-sidecar.
desktop/resources/restos-server
desktop/resources/restos-server.exe
desktop/resources/*.dll
desktop/resources/pg_dump*
desktop/resources/pg_restore*

# Android build artifacts
android/.gradle/
android/build/
android/app/build/
android/.idea/
android/local.properties
android/capacitor-cordova-android-plugins/
*.apk
*.aab

# Go server
server/bin/
server/postgres-data/
server/postgres-bin/
server/logs/
server/data/

# Embedded SPA assets (generated by `make embed-spa` before go build).
# Only .gitkeep + placeholder index.html are tracked — see spa.go.
server/internal/transport/http/spa/*
!server/internal/transport/http/spa/.gitkeep
!server/internal/transport/http/spa/index.html

# Local config / secrets
.env
.env.local
.env.*.local
*.secret
desktop/.pg-secret

# Test artifacts
test-results/
playwright-report/
coverage/

# OS
.DS_Store
Thumbs.db
*.swp
*~

# Editors
.vscode/
.idea/

# Lock files of tools we don't use
package-lock.json

# Spreadsheets и временные документы (project-specific)
*.xlsx
# …но шаблоны импорта — продуктовые ассеты, их коммитим (иначе сборка без
# них даёт битое скачивание: бэк отдаёт HTML вместо .xlsx).
!public/docs/*.xlsx
!server/internal/transport/http/docs/*.xlsx
.~lock*
correction.txt
ins.md
test_write.txt

# Claude Code harness state (do not commit)
.claude/
