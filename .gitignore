# Dependencies
node_modules/
.pnpm-store/

# Build artifacts
dist/
build/
.next/
*.tsbuildinfo
out/

# Electron release artifacts
desktop/release/
desktop/data/
desktop/dist/
desktop/frontend/

# Android build artifacts
android/.gradle/
android/build/
android/app/build/
android/.idea/
android/local.properties
android/capacitor-cordova-android-plugins/
*.apk
*.aab

# Go server
server/bin/
server/postgres-data/
server/postgres-bin/
server/logs/
server/data/

# Embedded SPA assets (generated by `make embed-spa` before go build).
# Only .gitkeep + placeholder index.html are tracked — see spa.go.
server/internal/transport/http/spa/*
!server/internal/transport/http/spa/.gitkeep
!server/internal/transport/http/spa/index.html

# Local config / secrets
.env
.env.local
.env.*.local
*.secret
desktop/.pg-secret

# Test artifacts
test-results/
playwright-report/
coverage/

# OS
.DS_Store
Thumbs.db
*.swp
*~

# Editors
.vscode/
.idea/

# Lock files of tools we don't use
package-lock.json

# Spreadsheets и временные документы (project-specific)
*.xlsx
# …но шаблоны импорта — продуктовые ассеты, их коммитим (иначе сборка без
# них даёт битое скачивание: бэк отдаёт HTML вместо .xlsx).
!public/docs/*.xlsx
!server/internal/transport/http/docs/*.xlsx
.~lock*
correction.txt
ins.md
test_write.txt

# Claude Code harness state (do not commit)
.claude/
